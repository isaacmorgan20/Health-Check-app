rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------
    // Helpers
    // ------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'morganisaackojo5547@gmail.com';
    }

    function isOwnProfile() {
      // Profile documents: doc id == uid, data has a matching 'uid' field
      return isSignedIn()
        && resource.data.uid == request.auth.uid;
    }

    function isOwnAppointment() {
      // Appointment documents: data has 'userUid' matching the caller
      return isSignedIn()
        && resource.data.userUid == request.auth.uid;
    }

    function isOwnAppointmentCreate() {
      return isSignedIn()
        && request.resource.data.userUid == request.auth.uid;
    }

    function isOwnProfileCreate() {
      return isSignedIn()
        && request.resource.data.uid == request.auth.uid;
    }

    // ------------------------------------------------------------
    // users collection (holds BOTH profiles and appointments)
    // ------------------------------------------------------------
    match /users/{docId} {

      allow read: if isAdmin()
        || isOwnProfile()
        || isOwnAppointment();

      allow create: if isAdmin()
        || isOwnProfileCreate()
        || isOwnAppointmentCreate();

      allow update: if isAdmin()
        || isOwnProfile()
        || isOwnAppointment();

      allow delete: if isAdmin()
        || isOwnProfile()
        || isOwnAppointment();
    }

    // ------------------------------------------------------------
    // packages collection (any signed-in user can read;
    // only admins can add/edit/disable)
    // ------------------------------------------------------------
    match /packages/{packageId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ------------------------------------------------------------
    // clinic collection (public info, editable only by admins)
    // ------------------------------------------------------------
    match /clinic/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------
    // Explicit deny for anything else
    // ------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}