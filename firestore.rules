rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------
    // Helpers
    // ------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isClinicAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "clinic_admin";
    }

    function isOwnProfile() {
      // Profile documents have 'uid' field matching the auth UID
      return isSignedIn()
        && resource.data.uid == request.auth.uid;
    }

    function isOwnAppointment() {
      // Appointment documents have 'userUid' field matching the auth UID
      return isSignedIn()
        && resource.data.userUid == request.auth.uid;
    }

    function isOwnProfileCreate() {
      return isSignedIn()
        && request.resource.data.uid == request.auth.uid;
    }

    function isOwnAppointmentCreate() {
      return isSignedIn()
        && request.resource.data.userUid == request.auth.uid;
    }

    // ------------------------------------------------------------
    // users collection (holds BOTH profiles and appointments)
    // ------------------------------------------------------------
    match /users/{docId} {

      allow read: if isSignedIn()
        && (isClinicAdmin() || isOwnProfile() || isOwnAppointment());

      allow create: if isSignedIn()
        && (isClinicAdmin() || isOwnProfileCreate() || isOwnAppointmentCreate());

      allow update: if isSignedIn()
        && (isClinicAdmin() || isOwnProfile() || isOwnAppointment());

      allow delete: if isSignedIn()
        && (isClinicAdmin() || isOwnProfile() || isOwnAppointment());
    }

    // ------------------------------------------------------------
    // packages collection (any signed-in user can read;
    // only clinic_admin can add/edit/disable)
    // ------------------------------------------------------------
    match /packages/{packageId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isClinicAdmin();
    }

    // ------------------------------------------------------------
    // clinic collection (public info, editable only by clinic_admin)
    // ------------------------------------------------------------
    match /clinic/{docId} {
      allow read: if isSignedIn();
      allow write: if isClinicAdmin();
    }

    // ------------------------------------------------------------
    // Explicit deny for anything else
    // ------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}